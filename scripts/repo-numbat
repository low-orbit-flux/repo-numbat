#!/usr/bin/env bash
# Launcher for Linux and macOS.
# Creates a private virtualenv next to the project on first run, installs the
# requirements into it, then starts the GUI.  Any arguments are passed through
# (e.g. --cli, --fetch, --root DIR).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT="$(cd "$HERE/.." && pwd)"
# shellcheck source=env.sh
source "$PROJECT/scripts/env.sh"

# $VENV/bin/repo-numbat is a symlink to the venv python (made by env.sh); running
# through it names the process repo-numbat so the desktop icon matches on X11.
exec "$VENV/bin/repo-numbat" -m repo_numbat "$@"
